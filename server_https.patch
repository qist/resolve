+// CacheBypassKey is the context key to signal that the cache plugin should skip
+// both cache lookup and cache storage for this request. Set by /resolve endpoint
+// to ensure fresh results for every query.
+type CacheBypassKey struct{}
+
+// WithCacheBypass returns a context that instructs the cache plugin to bypass caching.
+func WithCacheBypass(ctx context.Context) context.Context {
+	return context.WithValue(ctx, CacheBypassKey{}, true)
+}
+
+// IsCacheBypass returns true if the context has been marked to bypass caching.
+func IsCacheBypass(ctx context.Context) bool {
+	v, _ := ctx.Value(CacheBypassKey{}).(bool)
+	return v
+}
