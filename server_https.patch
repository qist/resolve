+// resolveResult represents a JSON DNS response for the /resolve endpoint.
+type resolveResult struct {
+	Name   string        `json:"Name"`
+	Type   string        `json:"Type"`
+	Status int           `json:"Status"`
+	TTL    uint32        `json:"TTL,omitempty"`
+	Answer []resolveAnswer `json:"Answer"`
+}
+
+type resolveAnswer struct {
+	Name string `json:"name"`
+	Type string `json:"type"`
+	TTL  uint32 `json:"ttl"`
+	Data string `json:"data"`
+}
+
+// serveResolve handles /resolve requests — builds a DNS query from HTTP params,
+// runs it through the plugin chain, and returns JSON.
+func (s *ServerHTTPS) serveResolve(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		resolveWriteJSON(w, http.StatusMethodNotAllowed, map[string]string{"Error": "method not allowed"})
+		return
+	}
+
+	name := r.URL.Query().Get("name")
+	if name == "" {
+		resolveWriteJSON(w, http.StatusBadRequest, map[string]string{"Error": "missing required 'name' parameter"})
+		return
+	}
+
+	qtypeStr := r.URL.Query().Get("type")
+	if qtypeStr == "" {
+		qtypeStr = "A"
+	}
+	qtype, ok := dns.StringToType[strings.ToUpper(qtypeStr)]
+	if !ok {
+		resolveWriteJSON(w, http.StatusBadRequest, map[string]string{"Error": "invalid query type"})
+		return
+	}
+
+	if !strings.HasSuffix(name, ".") {
+		name = name + "."
+	}
+
+	var clientIP net.IP
+	if cip := r.URL.Query().Get("cip"); cip != "" {
+		clientIP = net.ParseIP(cip)
+	} else if s.resolveEDNS0() {
+		clientIP = clientIPFromRequest(r)
+	}
+
+	msg := new(dns.Msg)
+	msg.SetQuestion(name, qtype)
+	msg.RecursionDesired = true
+
+	if clientIP != nil {
+		msg.SetEdns0(4096, false)
+		if opt := msg.IsEdns0(); opt != nil {
+			family := uint16(1)
+			mask := uint8(24)
+			if clientIP.To4() == nil {
+				family = 2
+				mask = 48
+			}
+			opt.Option = append(opt.Option, &dns.EDNS0_SUBNET{
+				Code:          dns.EDNS0SUBNET,
+				Family:        family,
+				SourceNetmask: mask,
+				SourceScope:   0,
+				Address:       clientIP,
+			})
+		}
+	}
+
+	ctx := context.WithValue(r.Context(), Key{}, s.Server)
+	ctx = context.WithValue(ctx, LoopKey{}, 0)
+	ctx = context.WithValue(ctx, HTTPRequestKey{}, r)
+	if s.resolveNoCache() {
+		ctx = plugin.WithCacheBypass(ctx)
+	}
+
+	dw := &DoHWriter{
+		laddr: s.localAddr(r),
+	}
+	h, p, _ := net.SplitHostPort(r.RemoteAddr)
+	port, _ := strconv.Atoi(p)
+	dw.raddr = &net.TCPAddr{IP: net.ParseIP(h), Port: port}
+
+	s.ServeDNS(ctx, dw, msg)
+
+	if dw.Msg == nil {
+		resolveWriteJSON(w, http.StatusInternalServerError, map[string]string{"Error": "no response"})
+		return
+	}
+
+	result := resolveToJSON(dw.Msg, qtypeStr)
+	resolveWriteJSON(w, http.StatusOK, result)
+}
+
+func resolveWriteJSON(w http.ResponseWriter, code int, v interface{}) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(code)
+	json.NewEncoder(w).Encode(v)
+}
+
+func resolveToJSON(msg *dns.Msg, qtypeStr string) resolveResult {
+	result := resolveResult{
+		Name:   msg.Question[0].Name,
+		Type:   qtypeStr,
+		Status: msg.Rcode,
+		Answer: []resolveAnswer{},
+	}
+	if msg.Rcode != dns.RcodeSuccess {
+		return result
+	}
+	var minTTL uint32 = math.MaxUint32
+	for _, rr := range msg.Answer {
+		result.Answer = append(result.Answer, resolveAnswer{
+			Name: rr.Header().Name,
+			Type: dns.TypeToString[rr.Header().Rrtype],
+			TTL:  rr.Header().Ttl,
+			Data: resolveRRData(rr),
+		})
+		if rr.Header().Ttl < minTTL {
+			minTTL = rr.Header().Ttl
+		}
+	}
+	if len(result.Answer) > 0 {
+		result.TTL = minTTL
+	}
+	return result
+}
+
+func resolveRRData(rr dns.RR) string {
+	switch v := rr.(type) {
+	case *dns.A:
+		return v.A.String()
+	case *dns.AAAA:
+		return v.AAAA.String()
+	case *dns.CNAME:
+		return v.Target
+	case *dns.MX:
+		return v.Mx
+	case *dns.NS:
+		return v.Ns
+	case *dns.TXT:
+		return strings.Join(v.Txt, " ")
+	case *dns.SRV:
+		return v.Target
+	case *dns.SOA:
+		return v.Ns
+	case *dns.PTR:
+		return v.Ptr
+	case *dns.CAA:
+		return v.Value
+	default:
+		s := rr.String()
+		header := rr.Header().String()
+		if strings.HasPrefix(s, header) {
+			return strings.TrimSpace(s[len(header):])
+		}
+		return s
+	}
+}
+
+func (s *ServerHTTPS) resolveEDNS0() bool {
+	for _, z := range s.zones {
+		for _, conf := range z {
+			if conf.ResolveEDNS0 {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (s *ServerHTTPS) resolveNoCache() bool {
+	for _, z := range s.zones {
+		for _, conf := range z {
+			if conf.ResolveNoCache {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// addECSFromHTTP injects EDNS0 Client Subnet into the DNS message based on the HTTP client IP.
+// It checks X-Forwarded-For, X-Real-IP headers for reverse proxy support.
+// If the message already contains an EDNS0 Client Subnet option, it is left unchanged.
+func addECSFromHTTP(msg *dns.Msg, r *http.Request) {
+	clientIP := clientIPFromRequest(r)
+	if clientIP == nil {
+		return
+	}
+
+	opt := msg.IsEdns0()
+	if opt == nil {
+		msg.SetEdns0(4096, false)
+		opt = msg.IsEdns0()
+		if opt == nil {
+			return
+		}
+	}
+
+	for _, o := range opt.Option {
+		if _, ok := o.(*dns.EDNS0_SUBNET); ok {
+			return
+		}
+	}
+
+	family := uint16(1)
+	mask := uint8(24)
+	if clientIP.To4() == nil {
+		family = 2
+		mask = 48
+	}
+	opt.Option = append(opt.Option, &dns.EDNS0_SUBNET{
+		Code:          dns.EDNS0SUBNET,
+		Family:        family,
+		SourceNetmask: mask,
+		SourceScope:   0,
+		Address:       clientIP,
+	})
+}
+
+func clientIPFromRequest(r *http.Request) net.IP {
+	if ip := r.Header.Get("X-Forwarded-For"); ip != "" {
+		if addr := net.ParseIP(strings.TrimSpace(strings.Split(ip, ",")[0])); addr != nil {
+			return addr
+		}
+	}
+	if ip := r.Header.Get("X-Real-IP"); ip != "" {
+		if addr := net.ParseIP(strings.TrimSpace(ip)); addr != nil {
+			return addr
+		}
+	}
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil {
+		host = r.RemoteAddr
+	}
+	return net.ParseIP(host)
+}
